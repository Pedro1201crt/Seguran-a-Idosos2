/* RESET E ESTILOS BASE */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 20px;
    line-height: 1.7;
    background-color: #eef2f5;
    color: #1a1a1a;
}

/* CABEÇALHO E NAVEGAÇÃO */
header {
    background-color: #0b3c5d;
    color: #ffffff;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
}

.header-content {
    text-align: center;
    padding: 20px 15px 10px 15px;
}

.header-content h1 {
    font-size: 34px;
    letter-spacing: 1px;
}

.header-content p {
    font-size: 20px;
    color: #d9e2ec;
}

.navbar {
    background-color: #062f4f;
    padding: 10px 0;
}

.navbar ul {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
}

.navbar a {
    color: #ffffff;
    text-decoration: none;
    font-weight: bold;
    font-size: 19px;
    padding: 8px 16px;
    border-radius: 6px;
    background-color: #12558a;
    transition: background-color 0.2s;
}

.navbar a:hover {
    background-color: #f6d55c;
    color: #000000;
}

/* ESTRUTURA PRINCIPAL */
.container {
    max-width: 1000px;
    margin: 30px auto;
    padding: 0 20px;
}

.card {
    background: #ffffff;
    border-radius: 12px;
    padding: 30px;
    margin-bottom: 30px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    border: 1px solid #dcdcdc;
}

.card h2 {
    color: #0b3c5d;
    font-size: 28px;
    margin-bottom: 15px;
    border-bottom: 3px solid #3282b8;
    padding-bottom: 8px;
}

.subtitulo {
    margin-bottom: 20px;
    font-weight: 500;
}

/* HERO CARD (BOAS-VINDAS) */
.hero-card {
    background-color: #ffffff;
    border-left: 10px solid #12558a;
    border-radius: 8px;
    padding: 30px;
    margin-bottom: 30px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.hero-card h2 {
    color: #0b3c5d;
    font-size: 30px;
    margin-bottom: 15px;
}

.destaque-dica {
    background-color: #e8f4f8;
    border: 2px solid #3282b8;
    padding: 20px;
    border-radius: 8px;
    margin-top: 20px;
    font-size: 21px;
}

/* DICIONÁRIO DIGITAL (GRID) */
.grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
}

.termo-box {
    background-color: #f8f9fa;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    padding: 20px;
}

.termo-box h3 {
    color: #12558a;
    font-size: 22px;
    margin-bottom: 8px;
}

/* PASSO A PASSO */
.passo-item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 25px;
    background-color: #f8f9fa;
    padding: 20px;
    border-radius: 8px;
}

.numero-passo {
    background-color: #0b3c5d;
    color: #ffffff;
    font-size: 28px;
    font-weight: bold;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.passo-item h3 {
    color: #0b3c5d;
    font-size: 22px;
    margin-bottom: 5px;
}

/* GUIA DE GOLPES */
.golpe-detalhe {
    background-color: #fff9e6;
    border: 2px solid #ffe0b2;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
}

.golpe-detalhe h3 {
    color: #c62828;
    font-size: 23px;
    margin-bottom: 10px;
}

.solucao-box {
    background-color: #e8f5e9;
    border-left: 5px solid #2e7d32;
    padding: 15px;
    margin-top: 15px;
    border-radius: 4px;
    color: #1b5e20;
}

/* TABELA DE CHECKLIST */
.tabela-checklist {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

.tabela-checklist th, 
.tabela-checklist td {
    padding: 15px;
    text-align: left;
    border: 1px solid #cccccc;
}

.tabela-checklist th {
    background-color: #0b3c5d;
    color: #ffffff;
    font-size: 20px;
}

.tabela-checklist tr:nth-child(even) {
    background-color: #f9f9f9;
}

/* AJUDA E CONTATOS */
.destaque-ajuda {
    background-color: #fbe9e7;
    border: 2px solid #ffab91;
}

.destaque-ajuda h2 {
    color: #d84315;
    border-bottom-color: #d84315;
}

.lista-contatos {
    list-style: none;
    margin-top: 15px;
}

.lista-contatos li {
    margin-bottom: 15px;
    padding: 10px;
    background-color: #ffffff;
    border-radius: 6px;
    border-left: 4px solid #d84315;
}

/* RODAPÉ */
footer {
    background-color: #0b3c5d;
    color: #ffffff;
    text-align: center;
    padding: 30px 20px;
    margin-top: 50px;
    font-size: 18px;
}

footer p {
    margin-bottom: 8px;
}

/* RESPONSIVIDADE PARA CELULARES */
@media (max-width: 600px) {
    body {
        font-size: 18px;
    }

    .header-content h1 {
        font-size: 26px;
    }

    .navbar ul {
        flex-direction: column;
    }

    .navbar a {
        text-align: center;
        display: block;
    }

    .passo-item {
        flex-direction: column;
    }
}